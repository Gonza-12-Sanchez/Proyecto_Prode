# App
APP_ENV=dev
SECRET_KEY=change-me-32chars-minimum-secret-key-please
JWT_EXPIRE_HOURS=24
MOCK_MODE=true

# DB - PostgreSQL async (psycopg - Windows compatible)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/prode

# Football API (optional - when MOCK_MODE=false)
FOOTBALL_API_KEY=
FOOTBALL_API_PROVIDER=api-football
FOOTBALL_API_BASE=https://v3.football.api-sports.io

# Scheduler
FIXTURES_CRON_HOUR=6
RESULTS_POLL_SECONDS=600

# Optional Redis cache (if used)
REDIS_URL=redis://localhost:6379/0

# Alembic sync URL (if needed for migrations without async driver)
# DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/quiniela
